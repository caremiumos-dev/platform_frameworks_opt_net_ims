      "writtenOn": "2020-11-11T00:29:23Z",
      "side": 1,
      "message": "Question:\nIs the relationship 1:1 between the contact and common table?\nOr could contact A have a common entry for both PRESENCE and OPTIONS?\n\nIf it\u0027s just 1:1, should the common data perhaps just move into the contact table?",
      "range": {
        "startLine": 44,
        "startChar": 39,
        "endLine": 44,
        "endChar": 72
      },
      "revId": "ccaee24bdc3e003ec1c4d942360f50a347112f83",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
