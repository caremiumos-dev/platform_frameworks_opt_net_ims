      "writtenOn": "2021-04-01T19:49:48Z",
      "side": 1,
      "message": "I see that ResponseRecord is synchronized due to this being called from a binder thread, however this is not. getErrorCode looks to be accessed from another thread. \n\nCan you please ensure that we do not run into multiple thread access issues here as well as in other setters/accessors? Would it be easier to throw the binders calls from vendor on the same looper to avoid such pitfalls?",
      "range": {
        "startLine": 239,
        "startChar": 16,
        "endLine": 239,
        "endChar": 28
      },
      "revId": "a576d15011066193a5ec181336b004a31dbdd659",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
